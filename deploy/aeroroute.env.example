# Variáveis de ambiente do serviço aeroroute (systemd EnvironmentFile).
#
# Instale como /etc/aeroroute.env (NÃO versione com as chaves reais):
#   sudo cp deploy/aeroroute.env.example /etc/aeroroute.env
#   sudo chown root:root /etc/aeroroute.env
#   sudo chmod 600 /etc/aeroroute.env
#   sudo nano /etc/aeroroute.env        # preencha as chaves
#
# Formato: CHAVE=valor (sem aspas, sem espaços ao redor do "=").

# --- REDEMET (DECEA) · METAR/TAF da página /tempo -----------------------
# Chave gratuita: https://api-redemet.decea.mil.br/cadastro-api/
REDEMET_API_KEY=cole_sua_chave_redemet_aqui

# --- AISWEB (DECEA) · cartas de aproximação (/cartas) -------------------
# Credenciais enviadas por e-mail pelo DECEA ao se cadastrar no AISWEB.
AISWEB_API_KEY=cole_sua_apikey_aisweb_aqui
AISWEB_API_PASS=cole_seu_apipass_aisweb_aqui

# --- Histórico de METAR (opcional) -------------------------------------
# Caminho do banco SQLite de climatologia. Padrão: app/data/wx_history.db.
# Recomendado apontar para fora do repositório (evita perder no deploy):
# WX_DB_PATH=/var/lib/aeroroute/wx_history.db
